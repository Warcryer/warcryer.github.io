---
// The banner at the top of a comparison: the Warcryer emblem, crossed blades,
// and the other product's name as a plain wordmark (never its logo).
interface Props { name: string }
const { name } = Astro.props;
---
<div class="versus" aria-hidden="true">
  <div class="vs-side vs-ours">
    <img src="/emblem.svg" alt="" width="96" height="96">
    <span>Warcryer</span>
  </div>
  <svg class="vs-blades" viewBox="0 0 120 120" width="120" height="120">
    <defs>
      <linearGradient id="vs-steel" x1="0" y1="0" x2="1" y2="1">
        <stop offset="0" stop-color="#f3dfa6" />
        <stop offset="1" stop-color="#a8843f" />
      </linearGradient>
    </defs>
    <g fill="none" stroke="url(#vs-steel)" stroke-width="3.2" stroke-linecap="round">
      <path d="M24 24 L84 84" />
      <path d="M96 24 L36 84" />
      <path d="M76 90 L90 76 M80 80 L94 94" />
      <path d="M44 90 L30 76 M40 80 L26 94" />
    </g>
    <circle cx="60" cy="54" r="17" fill="#0b0c0f" stroke="#7a6638" stroke-width="1.5" />
    <text x="60" y="60" text-anchor="middle" class="vs-text">VS</text>
  </svg>
  <div class="vs-side vs-them">
    <span class="vs-mark">{name.charAt(0)}</span>
    <span>{name}</span>
  </div>
</div>
