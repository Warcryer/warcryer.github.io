---
// "You are here" links, with the same trail for search engines.
import { SITE } from "../data/site";
interface Props { items: [name: string, path: string][] }
const { items } = Astro.props;
const ld = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: items.map(([name, path], i) => ({ "@type": "ListItem", position: i + 1, name, item: `${SITE}${path}` })),
};
---
<nav class="crumbs" aria-label="You are here">
  {items.map(([name, path], i) => (
    <>
      {i > 0 && <span aria-hidden="true">/</span>}
      {i < items.length - 1 ? <a href={path}>{name}</a> : <span aria-current="page">{name}</span>}
    </>
  ))}
</nav>
<script type="application/ld+json" set:html={JSON.stringify(ld)} />
