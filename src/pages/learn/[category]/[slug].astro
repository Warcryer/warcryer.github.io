---
// One Learn article, or an address an article used to have (which forwards to where it is now).
import Base from "../../../layouts/Base.astro";
import Crumbs from "../../../components/Crumbs.astro";
import LearnList from "../../../components/LearnList.astro";
import TryIt from "../../../components/TryIt.astro";
import "../../../styles/learn-article.css";
import { ARTICLES, MOVED, articleAt, categoryOf, day, minutes, type LearnArticle } from "../../../data/learn";
import { DISCORD, SITE } from "../../../data/site";

export function getStaticPaths() {
  const parts = (path: string) => {
    const [, , category, slug] = path.split("/");
    return { category, slug };
  };
  return [
    ...ARTICLES.map((a) => ({ params: parts(a.path), props: { a, to: null } })),
    ...MOVED.map((m) => ({ params: parts(m.from), props: { a: null, to: m.to } })),
  ];
}
const { a, to } = Astro.props as { a: LearnArticle; to: null } | { a: null; to: string };
if (!a) return Astro.redirect(to, 301);

const c = categoryOf(a);
const related = a.related.map(articleAt).filter((r): r is LearnArticle => Boolean(r));
const updated = a.publishedAt.slice(0, 10) !== a.firstPublishedAt.slice(0, 10);
const url = `${SITE}${a.path}`;
const ld = {
  "@context": "https://schema.org",
  "@type": "Article",
  headline: a.title,
  description: a.description,
  datePublished: a.firstPublishedAt,
  dateModified: a.publishedAt,
  inLanguage: "en",
  wordCount: a.words,
  articleSection: c.name,
  mainEntityOfPage: url,
  image: `${SITE}/shots/board.jpg`,
  author: { "@type": "Organization", name: "Warcryer", url: `${SITE}/` },
  publisher: { "@type": "Organization", name: "Warcryer", url: `${SITE}/`, logo: { "@type": "ImageObject", url: `${SITE}/favicon.png` } },
};
---
<Base title={`${a.title} · Warcryer`} description={a.description} type="article" bodyClass="page">
<Fragment slot="head">
  <meta property="article:published_time" content={a.firstPublishedAt}>
  <meta property="article:modified_time" content={a.publishedAt}>
  <meta property="article:section" content={c.name}>
  <script type="application/ld+json" set:html={JSON.stringify(ld).replace(/</g, "\\u003c")} />
</Fragment>
<section class="hero doc-hero">
  <Crumbs items={[["Warcryer", "/"], ["Learn", "/learn/"], [c.name, c.path], [a.title, a.path]]} />
  <h1>{a.title}</h1>
  <p class="lede">{a.promise}</p>
  <p class="fine learn-meta">{updated ? "Updated" : "Published"} <time datetime={a.publishedAt}>{day(a.publishedAt)}</time> · {minutes(a)} min read</p>
</section>
<section class="doc-section">
  <div class="doc">
    {a.toc.length > 3 && (
      <nav class="toc" aria-label="On this page">
        <details open data-toc>
          <summary class="toc-title">On this page</summary>
          <ol>{a.toc.map((h) => <li><a href={`#${h.anchor}`}>{h.title}</a></li>)}</ol>
        </details>
      </nav>
    )}
    <div class="learn-body">
      <article class="la" set:html={a.html} />
      {related.length > 0 && (
        <aside class="learn-next" aria-label="Read next">
          <h2>Read next</h2>
          <LearnList articles={related} />
        </aside>
      )}
      <p class="fine learn-made">
        {a.drafted
          ? <>How this article was made: it was researched and drafted with Claude, an AI model, from the sources listed above, then read, corrected and published by a person at Warcryer.</>
          : <>This article was written and published by a person at Warcryer.</>}
        {" "}Found a mistake? Tell us on the <a href={DISCORD}>Warcryer Discord</a>.
      </p>
    </div>
  </div>
</section>
<TryIt />
</Base>
<script>
  // On a narrow screen the contents list starts folded, so the text is in view.
  const toc = document.querySelector<HTMLDetailsElement>("[data-toc]");
  if (toc && matchMedia("(max-width: 900px)").matches) toc.open = false;
</script>
