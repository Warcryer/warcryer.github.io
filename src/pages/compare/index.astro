---
// The comparison hub: every product side by side, and a card for each page.
import Base from "../../layouts/Base.astro";
import Crumbs from "../../components/Crumbs.astro";
import TryIt from "../../components/TryIt.astro";
import MarkChip from "../../components/MarkChip.astro";
import { CHECKED, CHECKED_ISO, OUR_LIMITS, ROWS, ORDER, PRODUCTS } from "../../data/compare";
import { trademarkNote } from "../../data/compare-text";

const names = ORDER.map((k) => PRODUCTS[k].name);
const firstSentence = (t: string) => t.split(/(?<=\.)\s/)[0];
const builtIn = (k: (typeof ORDER)[number]) => ROWS.filter((r) => r.mark === "yes" && PRODUCTS[k].marks[r.id] && PRODUCTS[k].marks[r.id] !== "yes").length;
---
<Base
  title="Warcryer compared with TeamSpeak, Discord, Mumble and Ventrilo"
  description="Voice for large alliances, guilds and clans, side by side: what Warcryer does that TeamSpeak, Discord, Mumble and Ventrilo leave to you, and where each of them is the better choice."
  type="article"
  bodyClass="page compare-page"
  footNote={trademarkNote(names)}
>
<section class="hero">
  <Crumbs items={[["Warcryer", "/"], ["Compare", "/compare/"]]} />
  <h1>How Warcryer compares</h1>
  <p class="lede">TeamSpeak, Discord, Mumble and Ventrilo give you channels and leave the rest to you: who goes where, who may speak to whom, who signed up, who turned up, who earned what. Warcryer starts from the event's roster and works those out for you. It also does far less than they do outside organised play.</p>
  <p class="fine">Checked against each product's own pages on <time datetime={CHECKED_ISO}>{CHECKED}</time>. Warcryer is in beta.</p>
</section>

<section>
  <h2>One at a time</h2>
  <div class="matchups">
    {ORDER.map((k) => (
      <a class="matchup" href={`/compare/${k}/`}>
        <span class="matchup-head" aria-hidden="true">
          <img src="/emblem.svg" alt="" width="44" height="44">
          <span class="vs">VS</span>
          <span class="them">{PRODUCTS[k].name.charAt(0)}</span>
        </span>
        <h3>Warcryer vs {PRODUCTS[k].name}</h3>
        <p>{firstSentence(PRODUCTS[k].lede)}</p>
        <span class="chip chip-yes">{builtIn(k)} things built in that {PRODUCTS[k].name} leaves to you</span>
        <span class="more">Read the comparison →</span>
      </a>
    ))}
  </div>
</section>

<section>
  <h2>All five, side by side</h2>
  <div class="table-wrap">
  <table class="compare many">
    <thead>
      <tr><th scope="col"><span class="sr">What</span></th><th scope="col">Warcryer</th>{ORDER.map((k) => <th scope="col"><a href={`/compare/${k}/`}>{PRODUCTS[k].name}</a></th>)}</tr>
    </thead>
    <tbody>
      {ROWS.map((r) => (
        <tr><th scope="row">{r.label}</th><td><MarkChip mark={r.mark} />{r.ours}</td>{ORDER.map((k) => <td><MarkChip mark={PRODUCTS[k].marks[r.id]} />{PRODUCTS[k].cells[r.id]}</td>)}</tr>
      ))}
    </tbody>
  </table>
  </div>
  <p class="fine note">TeamSpeak's whisper lists, priority speaker and Channel Commander are described as in TeamSpeak 3; TeamSpeak 6 is in beta. Sources are listed on each product's own comparison page.</p>
</section>

<section>
  <h2>What Warcryer does not do</h2>
  <p class="intro">If one of these matters to you, one of the others is the better choice, and the page for it says which.</p>
  <ul class="limits">{OUR_LIMITS.map((l) => <li>{l}</li>)}</ul>
</section>

<TryIt />
</Base>
